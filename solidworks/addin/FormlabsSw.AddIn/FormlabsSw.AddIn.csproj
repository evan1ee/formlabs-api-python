<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>FormlabsSw.AddIn</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <RegisterForComInterop>false</RegisterForComInterop>
    <SwRedist Condition="'$(SwRedist)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist</SwRedist>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Icons\*.png" CopyToOutputDirectory="PreserveNewest" LinkBase="Icons" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FormlabsSw.Core\FormlabsSw.Core.csproj" />
    <Reference Include="SolidWorks.Interop.sldworks"><HintPath>$(SwRedist)\SolidWorks.Interop.sldworks.dll</HintPath><EmbedInteropTypes>false</EmbedInteropTypes><Private>false</Private></Reference>
    <Reference Include="SolidWorks.Interop.swconst"><HintPath>$(SwRedist)\SolidWorks.Interop.swconst.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SolidWorks.Interop.swpublished"><HintPath>$(SwRedist)\SolidWorks.Interop.swpublished.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="PresentationFramework" /><Reference Include="PresentationCore" /><Reference Include="WindowsBase" /><Reference Include="System.Xaml" /><Reference Include="WindowsFormsIntegration" />
  </ItemGroup>
</Project>
